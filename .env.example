# Required by the production Compose configuration. Do not commit real values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=UTC

# Docker Compose PostgreSQL connection. These are development-only placeholders.
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=recipe_cost_calculator
DJANGO_DB_USER=recipe_cost_calculator
DJANGO_DB_PASSWORD=replace-with-a-local-database-password
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432

# PostgreSQL container initialization. Keep these values aligned with Django's.
POSTGRES_DB=recipe_cost_calculator
POSTGRES_USER=recipe_cost_calculator
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Docker image for the web service. Set IMAGE_REPOSITORY to your registry
# repository on the deploy host; the deploy workflow overrides both values anyway.
IMAGE_REPOSITORY=recipe_app
IMAGE_TAG=dev

# Host port the web service is published on (default 8000; production uses 8001
# so it can run beside dev).
# WEB_PORT=8000

# Optional OpenTelemetry configuration. The deployed version (service.version) is
# baked into the image at build time from the build tag. DEPLOYMENT_ENVIRONMENT
# sets the deployment.environment label (for example dev or prod); it defaults to
# production, and DJANGO_ENV stays production either way.
# DEPLOYMENT_ENVIRONMENT=dev
# OTEL_SERVICE_NAME=recipe-cost-calculator
# For the shared-network alternative see observability/README.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# OTEL_SDK_DISABLED=false
# OTEL_PYTHON_DJANGO_EXCLUDED_URLS=health/
