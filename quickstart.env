# Quick start: for local evaluation only. Every value in this file is public,
# committed to the repository, and must never protect real data. The dev and
# production deployments do not use this file; they read their own secrets from
# `.env` and `.env.prod` instead.
#
# Start:  docker compose --env-file quickstart.env up --build --detach
# Open:   http://localhost:8080/
# Stop:   docker compose --env-file quickstart.env down
# Wipe:   docker compose --env-file quickstart.env down -v

# Its own Compose project, so containers, network, image and database volume
# never touch a dev or production deployment on the same host.
COMPOSE_PROJECT_NAME=recipe-cost-calculator-quickstart
IMAGE_REPOSITORY=recipe-cost-calculator-quickstart
IMAGE_TAG=local
WEB_PORT=8080
DEPLOYMENT_ENVIRONMENT=local

DJANGO_SECRET_KEY=quickstart-public-secret-key-for-local-evaluation-only-not-for-deployments
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_TIME_ZONE=UTC

POSTGRES_DB=recipe_cost_calculator
POSTGRES_USER=recipe_cost_calculator
POSTGRES_PASSWORD=quickstart-public-database-password
