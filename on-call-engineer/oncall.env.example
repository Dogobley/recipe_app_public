# On-call poller settings. Copy this file to `oncall.env` (gitignored), fill in
# the token, and start the poller with
#   python on-call-engineer/oncall.py --env-file on-call-engineer/oncall.env
# Variables already set in the environment take precedence over this file.
# Never commit oncall.env or put a real token in this example file.

# Grafana base URL (default http://localhost:3000).
ONCALL_GRAFANA_URL=http://localhost:3000

# Grafana service-account token with the Viewer role. Never the admin password.
ONCALL_GRAFANA_TOKEN=

# Agent command line. The prompt is sent on the agent's standard input and the
# agent runs inside the alert's git worktree. The poller has no built-in agent.
# Quote paths that contain backslashes or spaces with double quotes.
ONCALL_AGENT_COMMAND=claude -p
# Another example: ONCALL_AGENT_COMMAND=codex exec -

# Seconds between polls of Grafana's alert API (default 60).
ONCALL_POLL_INTERVAL=60

# Seconds an agent run may take before it is stopped (default 1800 = 30 minutes).
ONCALL_AGENT_TIMEOUT=1800

# Optional overrides (defaults shown):
# Owner label to act on, set by the alert rule of Issue 28.
# ONCALL_OWNER=recipe-calculator-oncall
# Repository the worktrees are created from, and the branch they start from.
# ONCALL_REPO_DIR=<the directory above on-call-engineer/>
# ONCALL_BASE_BRANCH=main
# Where the per-alert worktrees go (outside the repository by default).
# ONCALL_WORKTREES_DIR=<repository parent>/<repository name>-oncall-worktrees
# Run logs, and the file that remembers which firings were already handled.
# ONCALL_RUNS_DIR=on-call-engineer/runs
# ONCALL_STATE_FILE=on-call-engineer/state.json
