# Grafana admin credentials for the observability stack.
#
# Copy this file to `.env` in the deploy folder (OBSERVABILITY_PATH), next to
# compose.yaml, and replace the placeholders. `.env` is never committed and the
# Deploy observability workflow never overwrites or prints it. The workflow
# refuses to deploy while either value is missing, empty, still the placeholder,
# or the password is `admin`.
#
# Compose reads these values its own way. In an unquoted or double-quoted value
# `$name` is a variable reference, and in an unquoted value ` #` starts a
# comment. If the password contains `$`, write each `$` as `$$`, or wrap the
# whole value in single quotes, for example GRAFANA_ADMIN_PASSWORD='pa$s #word'.
# The workflow rejects a value Compose would change.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
