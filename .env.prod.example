# Production environment. Copy to .env.prod, replace every placeholder, and
# pass it explicitly: docker compose --env-file .env.prod <command>
# Do not commit real values.

# A separate Compose project gives production its own containers, network,
# image, and postgres_data volume, independent of the dev environment (.env).
COMPOSE_PROJECT_NAME=recipe-cost-calculator-prod
# Host port for production. The dev environment keeps the default 8000.
WEB_PORT=8001

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
DJANGO_TIME_ZONE=UTC

# PostgreSQL container initialization. The web container derives its
# DJANGO_DB_* connection values from these.
POSTGRES_DB=recipe_cost_calculator
POSTGRES_USER=recipe_cost_calculator
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Docker image for the web service. Set IMAGE_REPOSITORY to your registry
# repository; the deploy workflow overrides both values anyway.
IMAGE_REPOSITORY=replace-with-registry-repository
IMAGE_TAG=prod

# Telemetry. DEPLOYMENT_ENVIRONMENT labels production in Grafana; the deploy
# workflow sets IMAGE_TAG to the release being deployed.
DEPLOYMENT_ENVIRONMENT=prod
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_PYTHON_DJANGO_EXCLUDED_URLS=health/
